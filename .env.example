# ==============================
# Xiaomi S400 -> Garmin Connect
# ==============================

# Garmin Connect (used only to bootstrap/refresh OAuth tokens)
GARMIN_USERNAME=email_garmin
GARMIN_PASSWORD=password_garmin
GARMIN_IS_CN=false

# Xiaomi Body Composition Scale S400
# Obtain these ONCE during initial setup (see README.md)
S400_MAC=AA:BB:CC:DD:EE:FF
S400_BLE_KEY=00000000000000000000000000000000

# Your body profile. Used by export2garmin to calculate body composition.
USER_SEX=male
USER_HEIGHT_CM=181
USER_BIRTHDATE=01-01-1990
USER_WEIGHT_MIN_KG=55
USER_WEIGHT_MAX_KG=110

# Bluetooth adapter: hci0 => 0
HCI_INDEX=0

# Windows + Docker Desktop: native Windows BLE scanner. Linux hosts use linux.
BLE_SOURCE=linux

# Optional: upload S400 heart rate into Garmin blood-pressure section.
# Usually leave false.
UPLOAD_HEART_RATE=false

# Runtime
TZ=Europe/Madrid
